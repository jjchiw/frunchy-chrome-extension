// vite tsconfig
{
    "compilerOptions": {
        "composite": true,
        "module": "esnext",
        "moduleResolution": "bundler",
        "resolveJsonModule": true,
        "allowSyntheticDefaultImports": true,
        "types": ["node", "chrome"],
        "skipLibCheck": true
