{
  "name": "Frunchy",
  "description": "Frunchy is a browser extension for Crunchyroll.",
  "version": "0.1.0",
  "minimum_chrome_version": "119",
  "manifest_version": 3,
  "default_locale": "en",
  "icons": {
    "16": "src/assets/icons/frunchy16.png",
    "32": "src/assets/icons/frunchy32.png",
    "48": "src/assets/icons/frunchy48.png",
    "128": "src/assets/icons/frunchy128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://www.crunchyroll.com/*"],
      "js": ["src/content/index.ts"],
      "run_at": "document_start"
    }
  ],
  "background": {
    "service_worker": "src/background/service-worker.ts"
  },
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": false
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "Frunchy",
    "default_icon": {
      "16": "src/assets/icons/frunchy16.png",
      "32": "src/assets/icons/frunchy32.png",
      "48": "src/assets/icons/frunchy48.png",
      "128": "src/assets/icons/frunchy128.png"
    }
  },
  "permissions": ["alarms", "scripting", "storage", "unlimitedStorage"],
  "host_permissions": [
    "https://www.crunchyroll.com/*",
    "http://localhost:5099/*",
    "https://localhost:5001/*"
  ],
  "optional_host_permissions": ["http://*/*", "https://*/*"]
}
