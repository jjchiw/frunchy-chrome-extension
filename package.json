{
    "name": "frunchy-browser-extension",
    "version": "0.1.1",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "build:store": "vite build --mode store",
        "package": "npm run build:store && node scripts/package.mjs",
        "store:assets": "node scripts/store-assets/render.mjs",
        "icons": "node scripts/render-icons.mjs",
        "check": "svelte-check --tsconfig ./tsconfig.json"
    },
    "devDependencies": {
        "@crxjs/vite-plugin": "2.7.1",
        "@fontsource-variable/figtree": "5.3.0",
        "@fontsource/bricolage-grotesque": "5.3.0",
        "@fontsource/ibm-plex-mono": "5.3.0",
        "@material-symbols/svg-400": "0.47.6",
        "@sveltejs/vite-plugin-svelte": "7.3.1",
        "@tsconfig/svelte": "5.0.8",
        "@types/chrome": "0.3.4",
        "@types/node": "22.20.5",
        "svelte": "5.57.1",
        "svelte-check": "4.7.6",
        "typescript": "6.0.3",
        "vite": "8.3.2"
    },
    "engines": {
        "node": ">=22.12"
    }
}
